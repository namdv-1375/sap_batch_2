* TASK 17 WRITE AN EXECUTABLE PROGRAM WITH A ROUTINE THAT RECEIVES A WORK AREA.
TYPES: BEGIN OF TY_MIXED_DATA_17,
         NUMBER TYPE I,
         TEXT   TYPE STRING,
         AMOUNT TYPE P DECIMALS 2,
         DATE   TYPE DATUM,
         FLAG   TYPE XFELD,
       END OF TY_MIXED_DATA_17.

DATA: GS_DATA_17        TYPE TY_MIXED_DATA_17,
      GV_EMPTY_COUNT_17 TYPE I.


FORM TASK17.
  GS_DATA_17-NUMBER = 0.
  GS_DATA_17-AMOUNT = '100.50'.
  GS_DATA_17-FLAG = ABAP_FALSE.
  PERFORM COUNT_UNFILLED_COMPONENTS
    CHANGING GS_DATA_17
             GV_EMPTY_COUNT_17.
  PERFORM DISPLAY_RESULT_17.
ENDFORM.

FORM COUNT_UNFILLED_COMPONENTS
  CHANGING PS_DATA     TYPE TY_MIXED_DATA_17
           PV_COUNT    TYPE I.

  PV_COUNT = 0.
  IF PS_DATA-NUMBER IS INITIAL.
    ADD 1 TO PV_COUNT.
  ENDIF.

  IF PS_DATA-TEXT IS INITIAL.
    ADD 1 TO PV_COUNT.
  ENDIF.

  IF PS_DATA-AMOUNT IS INITIAL.
    ADD 1 TO PV_COUNT.
  ENDIF.

  IF PS_DATA-DATE IS INITIAL.
    ADD 1 TO PV_COUNT.
  ENDIF.

  IF PS_DATA-FLAG IS INITIAL.
    ADD 1 TO PV_COUNT.
  ENDIF.
ENDFORM.

* ROUTINE TO DISPLAY THE RESULT
FORM DISPLAY_RESULT_17.
  WRITE: / 'NUMBER OF UNFILLED COMPONENTS:', GV_EMPTY_COUNT_17.
ENDFORM.

