  APPEND VALUE #( COL1 = 'A' COL2 = 'ROW 1 COL2' COL3 = 'ROW 1 COL3' ) TO IT_DATA_30.
  APPEND VALUE #( COL1 = 'B' COL2 = 'ROW 2 COL2' COL3 = 'ROW 2 COL3' ) TO IT_DATA_30.
  APPEND VALUE #( COL1 = 'D' COL2 = 'ROW 4 COL2' COL3 = 'ROW 4 COL3' ) TO IT_DATA_30.

  WRITE: / 'UNSORTED TABLE:'.
  LOOP AT IT_DATA_30 INTO WA_DATA_30.
    WRITE: / WA_DATA_30-COL1, WA_DATA_30-COL2, WA_DATA_30-COL3.
  ENDLOOP.

  PERFORM SORT_TABLE_30 CHANGING IT_DATA_30.

  WRITE: / 'SORTED TABLE BY COL1:'.
  LOOP AT IT_DATA_30 INTO WA_DATA_30.
    WRITE: / WA_DATA_30-COL1, WA_DATA_30-COL2, WA_DATA_30-COL3.
  ENDLOOP.
ENDFORM.

* TASK 31 HAVE A ROUTINE THAT RECEIVES AN INTERNAL TABLE (WITH AT LEAST THREE COLUMNS).
TYPES: BEGIN OF TY_TABLE_31,
         COL1 TYPE STRING,
         COL2 TYPE STRING,
         COL3 TYPE STRING,
       END OF TY_TABLE_31.

TYPES: TT_TABLE_31 TYPE STANDARD TABLE OF TY_TABLE_31 WITH EMPTY KEY.

DATA: IT_DATA_31 TYPE TT_TABLE_31,
      WA_DATA_31 TYPE TY_TABLE_31.

FORM SORT_TABLE_31 USING IV_COLUMN_NAME TYPE STRING
                CHANGING CT_ANY_TABLE   TYPE TT_TABLE_31.
  FIELD-SYMBOLS: <SORT_FIELD> TYPE ANY.

  ASSIGN COMPONENT IV_COLUMN_NAME OF STRUCTURE WA_DATA_31 TO <SORT_FIELD>.
  IF SY-SUBRC <> 0.
    WRITE: / 'INVALID COLUMN NAME:', IV_COLUMN_NAME.
    EXIT.
  ENDIF.

  SORT CT_ANY_TABLE BY (IV_COLUMN_NAME).
ENDFORM.

* MAIN PROGRAM
FORM TASK31.
  DATA: LV_COLUMN_NAME TYPE STRING.
  APPEND VALUE #( COL1 = 'C' COL2 = 'ROW 3 COL2' COL3 = 'ROW 3 COL3' ) TO IT_DATA_31.
  APPEND VALUE #( COL1 = 'A' COL2 = 'ROW 1 COL2' COL3 = 'ROW 1 COL3' ) TO IT_DATA_31.
  APPEND VALUE #( COL1 = 'B' COL2 = 'ROW 2 COL2' COL3 = 'ROW 2 COL3' ) TO IT_DATA_31.
  APPEND VALUE #( COL1 = 'D' COL2 = 'ROW 4 COL2' COL3 = 'ROW 4 COL3' ) TO IT_DATA_31.

  WRITE: / 'UNSORTED TABLE:'.
  LOOP AT IT_DATA_31 INTO WA_DATA_31.
    WRITE: / WA_DATA_31-COL1, WA_DATA_31-COL2, WA_DATA_31-COL3.
  ENDLOOP.

  LV_COLUMN_NAME = 'COL2'.
  PERFORM SORT_TABLE_31 USING LV_COLUMN_NAME CHANGING IT_DATA_31.

  WRITE: / 'SORTED TABLE BY', LV_COLUMN_NAME, ':'.
  LOOP AT IT_DATA_31 INTO WA_DATA_31.
    WRITE: / WA_DATA_31-COL1, WA_DATA_31-COL2, WA_DATA_31-COL3.
  ENDLOOP.
ENDFORM.

* TASK 32 HAVE A ROUTINE THAT RECEIVES AN INTERNAL TABLE (WITH AT LEAST THREE COLUMNS).
TYPES: BEGIN OF TY_TABLE_32,
         COL1 TYPE STRING,
         COL2 TYPE STRING,
         COL3 TYPE STRING,
       END OF TY_TABLE_32.
TYPES: TT_TABLE_32 TYPE STANDARD TABLE OF TY_TABLE_32 WITH EMPTY KEY.

TYPES: BEGIN OF TY_SORT_COLUMNS_32,
         COLUMN_NAME TYPE STRING,
       END OF TY_SORT_COLUMNS_32.
TYPES: TT_SORT_COLUMNS_32 TYPE STANDARD TABLE OF TY_SORT_COLUMNS_32 WITH EMPTY KEY.

DATA: IT_DATA_32      TYPE TT_TABLE_32,
      WA_DATA_32      TYPE TY_TABLE_32,
      IT_SORT_COLUMNS TYPE TT_SORT_COLUMNS_32,
      WA_SORT_COLUMN  TYPE TY_SORT_COLUMNS_32.


FORM SORT_TABLE_DYNAMIC USING IT_SORT_COLUMNS TYPE TT_SORT_COLUMNS_32
                        CHANGING CT_ANY_TABLE TYPE TT_TABLE_32.

  FIELD-SYMBOLS: <SORT_FIELD> TYPE ANY.
  DATA(SORT_TAB) = VALUE ABAP_SORTORDER_TAB( ).

  LOOP AT IT_SORT_COLUMNS INTO WA_SORT_COLUMN.
    " CHECK IF THE COLUMN EXISTS IN THE STRUCTURE
    ASSIGN COMPONENT WA_SORT_COLUMN-COLUMN_NAME OF STRUCTURE WA_DATA_32 TO <SORT_FIELD>.
    IF SY-SUBRC <> 0.
      WRITE: / 'INVALID COLUMN NAME:', WA_SORT_COLUMN-COLUMN_NAME.
      EXIT.
    ENDIF.

    APPEND VALUE ABAP_SORTORDER( NAME = WA_SORT_COLUMN-COLUMN_NAME ) TO SORT_TAB.
  ENDLOOP.

  IF SORT_TAB IS NOT INITIAL.
    SORT CT_ANY_TABLE BY (SORT_TAB).
  ELSE.
    WRITE: / 'NO VALID COLUMNS PROVIDED FOR SORTING.'.
  ENDIF.
ENDFORM.

* MAIN PROGRAM
FORM TASK32.
  APPEND VALUE #( COL1 = 'C' COL2 = 'ROW 3 COL2' COL3 = '3' ) TO IT_DATA_32.
  APPEND VALUE #( COL1 = 'A' COL2 = 'ROW 1 COL2' COL3 = '2' ) TO IT_DATA_32.
  APPEND VALUE #( COL1 = 'B' COL2 = 'ROW 2 COL2' COL3 = '1' ) TO IT_DATA_32.
  APPEND VALUE #( COL1 = 'A' COL2 = 'ROW 4 COL2' COL3 = '3' ) TO IT_DATA_32.

  APPEND VALUE #( COLUMN_NAME = 'COL1' ) TO IT_SORT_COLUMNS.
  APPEND VALUE #( COLUMN_NAME = 'COL3' ) TO IT_SORT_COLUMNS.

  WRITE: / 'UNSORTED TABLE:'.
  LOOP AT IT_DATA_32 INTO WA_DATA_32.
    WRITE: / WA_DATA_32-COL1, WA_DATA_32-COL2, WA_DATA_32-COL3.
  ENDLOOP.

  PERFORM SORT_TABLE_DYNAMIC USING IT_SORT_COLUMNS CHANGING IT_DATA_32.

  WRITE: / 'SORTED TABLE BY SPECIFIED COLUMNS:'.
  LOOP AT IT_DATA_32 INTO WA_DATA_32.
    WRITE: / WA_DATA_32-COL1, WA_DATA_32-COL2, WA_DATA_32-COL3.
  ENDLOOP.
ENDFORM.

