  PV_SUM = PV_SUM + PS_NUMERIC_DATA-PACKED_NUM.
  PV_SUM = PV_SUM + PS_NUMERIC_DATA-FLOAT_NUM.
  PV_SUM = PV_SUM + PS_NUMERIC_DATA-DECIMAL_NUM.
