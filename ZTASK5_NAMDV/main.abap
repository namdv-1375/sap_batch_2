" TASK 1 WRITE AN EXECUTABLE PROGRAM THAT PERFORMS THE FOLLOWING CALCULATION: 2 + 3 * 5.
FORM TASK1.
  DATA: RESULT TYPE i.
  RESULT = 2 + 3 * 5.
  WRITE: / 'Output:', RESULT.
ENDFORM.

" TASK 2 WRITE AN EXECUTABLE PROGRAM THAT GETS TWO INTEGERS AND PERFORMS CALCULATIONS.
FORM TASK2.
  DATA: NUM1           TYPE I VALUE 10,
        NUM2           TYPE I VALUE 5,
        ADDITION       TYPE I,
        SUBTRACTION    TYPE I,
        MULTIPLICATION TYPE I,
        DIVISION       TYPE I,
        POWER          TYPE I.

  ADDITION = NUM1 + NUM2.
  SUBTRACTION = NUM1 - NUM2.
  MULTIPLICATION = NUM1 * NUM2.
  DIVISION = NUM1 / NUM2.
  POWER = NUM1 ** NUM2.

  WRITE: / 'ADDITION:', ADDITION,
         / 'SUBTRACTION:', SUBTRACTION,
         / 'MULTIPLICATION:', MULTIPLICATION,
         / 'DIVISION:', DIVISION,
         / 'POWER:', POWER.
ENDFORM.

" TASK 3 WRITE AN EXECUTABLE PROGRAM THAT GETS TWO INTEGERS VIA PARAMETERS AND PERFORMS CALCULATIONS.
SELECTION-SCREEN BEGIN OF BLOCK BT03 WITH FRAME TITLE TEXT-B03.
PARAMETERS: P_NUM1 TYPE I, P_NUM2 TYPE I.
SELECTION-SCREEN END OF BLOCK BT03.

FORM TASK3 USING U_NUM1 TYPE I
                 U_NUM2 TYPE I.
  DATA: ADDITION       TYPE I,
        SUBTRACTION    TYPE I,
        MULTIPLICATION TYPE I,
        DIVISION       TYPE I,
        POWER          TYPE I.

  IF U_NUM1 IS INITIAL OR U_NUM2 IS INITIAL.
    RETURN.
  ENDIF.

  ADDITION = U_NUM1 + U_NUM2.
  SUBTRACTION = U_NUM1 - U_NUM2.
  MULTIPLICATION = U_NUM1 * U_NUM2.

  IF U_NUM2 NE 0.
    DIVISION = U_NUM1 / U_NUM2.
  ELSE.
    DIVISION = 0.
  ENDIF.
  POWER = P_NUM1 ** P_NUM2.

  WRITE: / 'ADDITION:', ADDITION,
         / 'SUBTRACTION:', SUBTRACTION,
         / 'MULTIPLICATION:', MULTIPLICATION,
         / 'DIVISION:', DIVISION,
         / 'POWER:', POWER.
ENDFORM.

" TASK 4 WRITE AN EXECUTABLE PROGRAM THAT CONCATENATES TWO WORDS AND WRITES THE RESULT.
FORM TASK4.
  DATA: WORD1        TYPE STRING VALUE 'HELLO',
        WORD2        TYPE STRING VALUE 'WORLD',
        CONCATENATED TYPE STRING.

  CONCATENATE WORD1 WORD2 INTO CONCATENATED SEPARATED BY SPACE.
  WRITE: / 'OUTPUT:', CONCATENATED.
ENDFORM.

" TASK 5 WRITE AN EXECUTABLE PROGRAM THAT CONCATENATES TWO WORDS AND THE CURRENT MONTH.
FORM TASK5.
  DATA: WORD1  TYPE STRING VALUE 'HELLO',
        WORD2  TYPE STRING VALUE 'WORLD',
        MONTH  TYPE STRING,
        RESULT TYPE STRING.

  MONTH = SY-DATUM+4(2).
  RESULT = |{ WORD1 }-{ WORD2 }-{ MONTH }|.
  WRITE: / RESULT.
ENDFORM.

" TASK 6 WRITE AN EXECUTABLE PROGRAM THAT READS THE CURRENT SYSTEM DATE AND WRITES IT IN TEXT FORMAT.
FORM TASK6.
  DATA: LV_DAY      TYPE STRING,
        LV_MONTH    TYPE STRING,
        LV_YEAR     TYPE STRING,
        LV_MONTH_S  TYPE T247,
        LS_DATE     TYPE STRING.

  CALL FUNCTION 'IDWT_READ_MONTH_TEXT'
    EXPORTING
      LANGU = SY-LANGU
      MONTH = SY-DATUM+4(2)
    IMPORTING
      T247  = LV_MONTH_S.
  LV_MONTH = LV_MONTH_S-LTX.

* HANDLE DAY
  IF SY-DATUM+6(2) = '01'.
    LV_DAY = 'FIRST'.
  ELSEIF SY-DATUM+6(2) = '02'.
    LV_DAY = 'SECOND'.
  ELSEIF SY-DATUM+6(2) = '03'.
    LV_DAY = 'THIRD'.
  ELSE.
    IF SY-DATUM+6(2) BETWEEN 04 AND 19.
      CASE SY-DATUM+6(2).
        WHEN '04'. LV_DAY = 'FOURTH'.
        WHEN '05'. LV_DAY = 'FIFTH'.
        WHEN '06'. LV_DAY = 'SIXTH'.
        WHEN '07'. LV_DAY = 'SEVENTH'.
        WHEN '08'. LV_DAY = 'EIGHTH'.
        WHEN '09'. LV_DAY = 'NINTH'.
        WHEN '10'. LV_DAY = 'TENTH'.
        WHEN '11'. LV_DAY = 'ELEVENTH'.
        WHEN '12'. LV_DAY = 'TWELFTH'.
        WHEN '13'. LV_DAY = 'THIRTEENTH'.
        WHEN '14'. LV_DAY = 'FOURTEENTH'.
        WHEN '15'. LV_DAY = 'FIFTEENTH'.
        WHEN '16'. LV_DAY = 'SIXTEENTH'.
        WHEN '17'. LV_DAY = 'SEVENTEENTH'.
        WHEN '18'. LV_DAY = 'EIGHTEENTH'.
        WHEN '19'. LV_DAY = 'NINETEENTH'.
      ENDCASE.
      CONCATENATE LV_DAY 'TH' INTO LV_DAY.
    ELSE.
      CASE SY-DATUM+6(2).
        WHEN '20'. LV_DAY = 'TWENTIETH'.
        WHEN '21'. LV_DAY = 'TWENTY-FIRST'.
        WHEN '22'. LV_DAY = 'TWENTY-SECOND'.
        WHEN '23'. LV_DAY = 'TWENTY-THIRD'.
        WHEN '24'. LV_DAY = 'TWENTY-FOURTH'.
        WHEN '25'. LV_DAY = 'TWENTY-FIFTH'.
        WHEN '26'. LV_DAY = 'TWENTY-SIXTH'.
        WHEN '27'. LV_DAY = 'TWENTY-SEVENTH'.
        WHEN '28'. LV_DAY = 'TWENTY-EIGHTH'.
        WHEN '29'. LV_DAY = 'TWENTY-NINTH'.
        WHEN '30'. LV_DAY = 'THIRTIETH'.
        WHEN '31'. LV_DAY = 'THIRTY-FIRST'.
      ENDCASE.
    ENDIF.
  ENDIF.

* HANDLE YEAR
  LV_YEAR = SY-DATUM(4).

* PRINT RESULT
  WRITE: /'OUTPUT:', LV_MONTH, ' THE ', LV_DAY, ', ', LV_YEAR. NEW-LINE.
ENDFORM.

" TASK 7 WRITE AN EXECUTABLE PROGRAM THAT READS THE CURRENT SYSTEM TIME AND WRITES THE TIME IN 6 DIFFERENT ZONES.
FORM TASK7.
  DATA LV_TIMEZONE1        TYPE TZNZONE VALUE 'GMTUK'.
  DATA LV_TIMEZONE2        TYPE TZNZONE VALUE 'INDIA'.
  DATA LV_TIMEZONE3        TYPE TZNZONE VALUE 'BRAZIL'.
  DATA LV_TIMEZONE4        TYPE TZNZONE VALUE 'CST'.
  DATA LV_TIMEZONE5        TYPE TZNZONE VALUE 'ISRAEL'.
  DATA LV_TIMEZONE6        TYPE TZNZONE VALUE 'RUS06'.
  DATA LV_TIMESTAMP        TYPE TZONREF-TSTAMPS.
  DATA LV_TIMESTAMP_STRING TYPE STRING.

  CONCATENATE SY-DATUM SY-UZEIT INTO LV_TIMESTAMP_STRING.
  LV_TIMESTAMP = LV_TIMESTAMP_STRING.

  WRITE: / LV_TIMEZONE1, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE1. NEW-LINE.
  WRITE: / LV_TIMEZONE2, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE2. NEW-LINE.
  WRITE: / LV_TIMEZONE3, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE3. NEW-LINE.
  WRITE: / LV_TIMEZONE4, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE4. NEW-LINE.
  WRITE: / LV_TIMEZONE5, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE5. NEW-LINE.
  WRITE: / LV_TIMEZONE6, ':', LV_TIMESTAMP TIME ZONE LV_TIMEZONE6. NEW-LINE.
ENDFORM.

" TASK 8 WRITE AN EXECUTABLE PROGRAM THAT COUNTS HOW MANY VOWELS ARE IN THE NAME OF THE USER.
FORM TASK8.
  DATA LV_VOWELS_COUNT TYPE I.
  DATA LV_USER LIKE SY-UNAME.

  LV_USER = SY-UNAME.

  TRANSLATE LV_USER TO UPPER CASE.

  FIND ALL OCCURRENCES OF REGEX 'A|E|I|O|U' IN LV_USER MATCH COUNT LV_VOWELS_COUNT.

  WRITE: / 'USER:', LV_USER.
  WRITE: / 'TOTAL VOWELS:', LV_VOWELS_COUNT.
ENDFORM.

" TASK 9 WRITE AN EXECUTABLE PROGRAM THAT COUNTS A STRING LENGTH AND IF IT'S BIGGER THAN 20 CHARACTERS.
FORM TASK9.
  DATA LV_STRING TYPE STRING VALUE '1234567890ABCDEFGHIJ21'.
  DATA LV_STRING_LENGTH TYPE I.
  LV_STRING_LENGTH = STRLEN( LV_STRING ).

  IF LV_STRING_LENGTH > 20.
    WRITE 'TOO BIG'.
  ELSE.
    WRITE LV_STRING_LENGTH.
  ENDIF.
ENDFORM.

" TASK 10 WRITE AN EXECUTABLE PROGRAM THAT COUNTS FROM 1 TO 100 AND FOR EACH MULTIPLE.
FORM TASK10.
  DATA LV_CURRENT_NUMBER TYPE I VALUE 1.

  WHILE LV_CURRENT_NUMBER <= 100.
    IF ( LV_CURRENT_NUMBER MOD 8 ) = 0.
      WRITE: 'THE NUMBER', LV_CURRENT_NUMBER, ' IS A MULTIPLE OF 8'.
      NEW-LINE.
    ENDIF.
    ADD 1 TO LV_CURRENT_NUMBER.
  ENDWHILE.
ENDFORM.

" TASK 11 WRITE AN EXECUTABLE PROGRAM THAT CONTAINS A ROUTINE WHICH PRINTS ALL USERNAMES IN THE SYSTEM.
TYPES GTT_USERS TYPE TABLE OF USR04-BNAME.

FORM TASK11.
  DATA LT_USERS TYPE GTT_USERS.
  SELECT BNAME
  FROM USR04
  INTO TABLE LT_USERS.
  PERFORM PRINT_USERS USING LT_USERS.
ENDFORM.

FORM PRINT_USERS USING U_LT_USERS TYPE GTT_USERS.
  DATA LS_USER TYPE LINE OF GTT_USERS.
  LOOP AT U_LT_USERS INTO LS_USER.
    WRITE LS_USER. NEW-LINE.
  ENDLOOP.
ENDFORM.

" TASK 12 PRINT THE CONTENTS OF ALL GLOBAL VARIABLES BEFORE THE ROUTINE IS CALLED.
DATA: GV_VAR1 TYPE I VALUE 5,
      GV_VAR2 TYPE I VALUE 10,
      GV_VAR3 TYPE I VALUE 15,
      GV_VAR4 TYPE I VALUE 20.

FORM TASK12.
  WRITE: /'BEFORE CALL FORM:'.
  WRITE: /'GV_VAR1:', GV_VAR1,
         /'GV_VAR2:', GV_VAR2,
         /'GV_VAR3:', GV_VAR3,
         /'GV_VAR4:', GV_VAR4.

  PERFORM HANDLE_VALUES_TASK_12 USING    GV_VAR1 GV_VAR2
                                CHANGING GV_VAR3 GV_VAR4.

  WRITE: /'AFTER CALLING FORM:'.
  WRITE: /'GV_VAR1:', GV_VAR1,
         /'GV_VAR2:', GV_VAR2,
         /'GV_VAR3:', GV_VAR3,
         /'GV_VAR4:', GV_VAR4.
  WRITE: / SY-ULINE.
ENDFORM.

FORM HANDLE_VALUES_TASK_12 USING    U_VAR1 TYPE I
                                    U_VAR2 TYPE I
                           CHANGING C_VAR3 TYPE I
                                    C_VAR4 TYPE I.

  WRITE: / 'AT THE BEGINNING OF FORM:'.
  WRITE: / 'GV_VAR1:', U_VAR1,
         / 'GV_VAR2:', U_VAR2,
         / 'GV_VAR3:', C_VAR3,
         / 'GV_VAR4:', C_VAR4.

  C_VAR3 = C_VAR3 + 20.
  C_VAR4 = C_VAR4 + 25.

  WRITE: / 'AT THE END OF FORM:'.
  WRITE: / 'GV_VAR1:', U_VAR1,
         / 'GV_VAR2:', U_VAR2,
         / 'GV_VAR3:', C_VAR3,
         / 'GV_VAR4:', C_VAR4.
ENDFORM.

* TASK 13
* 13. WRITE AN EXECUTABLE PROGRAM THAT HAS A ROUTINE THAT RECEIVES TWO NUMBERS.

DATA GV_LARGEST TYPE F.

FORM GET_LARGER
USING
  NUMBER_A TYPE F
  NUMBER_B TYPE F
CHANGING
  LARGEST_NUMBER TYPE F.

  IF NUMBER_A >= NUMBER_B.
    LARGEST_NUMBER = NUMBER_A.
  ELSE.
    LARGEST_NUMBER = NUMBER_B.
  ENDIF.
ENDFORM.

FORM TASK13.
  PERFORM GET_LARGER USING 1 2 CHANGING GV_LARGEST.
  WRITE GV_LARGEST EXPONENT 0. NEW-LINE.
  PERFORM GET_LARGER USING 4 3 CHANGING GV_LARGEST.
  WRITE GV_LARGEST EXPONENT 0. NEW-LINE.
  PERFORM GET_LARGER USING 5 5 CHANGING GV_LARGEST.
  WRITE GV_LARGEST EXPONENT 0. NEW-LINE.
  PERFORM GET_LARGER USING '6.2' '7.1' CHANGING GV_LARGEST.
  WRITE GV_LARGEST EXPONENT 0. NEW-LINE.
ENDFORM.

* TASK 14 WRITE AN EXECUTABLE PROGRAM THAT HAS A ROUTINE THAT RECEIVES TWO NUMBERS AND RETURNS A FLAG.

DATA GV_FLAG TYPE C.

FORM SET_FLAG_IF_EQUAL
USING
  NUMBER_A TYPE F
  NUMBER_B TYPE F
CHANGING
  FLAG TYPE C.

  IF NUMBER_A = NUMBER_B.
    FLAG = 'X'.
  ELSE.
    FLAG = ' '.
  ENDIF.
ENDFORM.

FORM TASK14.
  DATA: NUMBER_A TYPE F,
        NUMBER_B TYPE F.

  NUMBER_A = 1.
  NUMBER_B = 1.
  PERFORM SET_FLAG_IF_EQUAL USING NUMBER_A NUMBER_B CHANGING GV_FLAG.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, FLAG: { GV_FLAG } |.

  NUMBER_A = 4.
  NUMBER_B = 3.
  PERFORM SET_FLAG_IF_EQUAL USING NUMBER_A NUMBER_B CHANGING GV_FLAG.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, FLAG: { GV_FLAG } |.

  NUMBER_A = 5.
  NUMBER_B = 5.
  PERFORM SET_FLAG_IF_EQUAL USING NUMBER_A NUMBER_B CHANGING GV_FLAG.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, FLAG: { GV_FLAG } |.

  NUMBER_A = '6.2'.
  NUMBER_B = '7.1'.
  PERFORM SET_FLAG_IF_EQUAL USING NUMBER_A NUMBER_B CHANGING GV_FLAG.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, FLAG: { GV_FLAG } |.

ENDFORM.

* TASK 15 WRITE AN EXECUTABLE PROGRAM THAT HAS A ROUTINE THAT TAKES TWO NUMBERS AND WRITES.

DATA GV_RESULT TYPE F.

FORM DIVISION_OR_POWER2
USING
  NUMBER_A TYPE F
  NUMBER_B TYPE F
CHANGING
  RESULT TYPE F.

  DATA LV_NUMBER_EQUAL TYPE C.
  PERFORM SET_FLAG_IF_EQUAL
  USING
  NUMBER_A
  NUMBER_B
  CHANGING
  LV_NUMBER_EQUAL.
  IF LV_NUMBER_EQUAL = ABAP_TRUE.
    RESULT = NUMBER_A ** 2.
  ELSE.
    DATA LV_LARGER_NUMBER TYPE F.
    PERFORM GET_LARGER USING NUMBER_A NUMBER_B CHANGING LV_LARGER_NUMBER.
    IF NUMBER_A = LV_LARGER_NUMBER.
      RESULT = NUMBER_A / NUMBER_B.
    ELSE.
      RESULT = NUMBER_B / NUMBER_A.
    ENDIF.
  ENDIF.
  NEW-LINE.
ENDFORM.


FORM TASK15.
  DATA: NUMBER_A TYPE F,
        NUMBER_B TYPE F.

  NUMBER_A = 1.
  NUMBER_B = 1.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.

  NUMBER_A = 3.
  NUMBER_B = 3.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.

  NUMBER_A = 6.
  NUMBER_B = 2.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.

  NUMBER_A = 2.
  NUMBER_B = 6.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.

  NUMBER_A = 10.
  NUMBER_B = 2.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.

  NUMBER_A = 2.
  NUMBER_B = 10.
  PERFORM DIVISION_OR_POWER2
  USING NUMBER_A NUMBER_B
  CHANGING GV_RESULT.
  WRITE: / |A: { NUMBER_A }, B: { NUMBER_B }, GV_RESULT: { GV_RESULT } |.
ENDFORM.

