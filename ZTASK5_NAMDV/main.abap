* ROUTINE TO COUNT VOWELS USING REGEX
FORM COUNT_VOWELS
  USING    P_STRING    TYPE CHAR20
  CHANGING RV_COUNT    TYPE I.

  DATA: LV_STRING  TYPE STRING,
        LT_MATCHES TYPE MATCH_RESULT_TAB.

  LV_STRING = TO_UPPER( P_STRING ).

  FIND ALL OCCURRENCES OF REGEX '[AEIOU]'
    IN LV_STRING
    RESULTS LT_MATCHES.

  RV_COUNT = LINES( LT_MATCHES ).
ENDFORM.

* ROUTINE TO PROCESS AND CLEAR COMPONENTS BASED ON SPECIFIED RULES
FORM PROCESS_COMPONENTS
  CHANGING CS_DATA TYPE TY_MIXED_DATA_19.

  DATA: LV_NUMERIC_SUM  TYPE DECFLOAT34,
        LV_VOWEL_COUNT  TYPE I,
        LV_TOTAL_VOWELS TYPE I.

  LV_NUMERIC_SUM = ABS( CS_DATA-NUM1 ) +
                   ABS( TRUNC( CS_DATA-NUM2 ) ) +
                   ABS( TRUNC( CS_DATA-NUM3 ) ).

  CLEAR LV_TOTAL_VOWELS.

  PERFORM COUNT_VOWELS
    USING CS_DATA-CHAR1
    CHANGING LV_VOWEL_COUNT.
  ADD LV_VOWEL_COUNT TO LV_TOTAL_VOWELS.

  PERFORM COUNT_VOWELS
    USING CS_DATA-CHAR2
    CHANGING LV_VOWEL_COUNT.
  ADD LV_VOWEL_COUNT TO LV_TOTAL_VOWELS.

  PERFORM COUNT_VOWELS
    USING CS_DATA-CHAR3
    CHANGING LV_VOWEL_COUNT.
  ADD LV_VOWEL_COUNT TO LV_TOTAL_VOWELS.

  IF LV_NUMERIC_SUM MOD 2 = 1.
    CLEAR: CS_DATA-CHAR1,
           CS_DATA-CHAR2,
           CS_DATA-CHAR3.
  ENDIF.

  IF LV_TOTAL_VOWELS MOD 2 = 0.
    CLEAR: CS_DATA-NUM1,
           CS_DATA-NUM2,
           CS_DATA-NUM3.
  ENDIF.
ENDFORM.

* ROUTINE TO DISPLAY RESULTS
FORM DISPLAY_RESULTS.
  WRITE: / 'CHARACTER COMPONENTS:'.
  WRITE: / 'CHAR1:', GS_DATA_19-CHAR1.
  WRITE: / 'CHAR2:', GS_DATA_19-CHAR2.
  WRITE: / 'CHAR3:', GS_DATA_19-CHAR3.

  WRITE: / 'NUMERIC COMPONENTS:'.
  WRITE: / 'NUM1:', GS_DATA_19-NUM1.
  WRITE: / 'NUM2:', GS_DATA_19-NUM2.
  WRITE: / 'NUM3:', GS_DATA_19-NUM3.
ENDFORM.

* TASK 20 WRITE AN EXECUTABLE PROGRAM WHICH CONTAINS THREE INTERNAL TABLES (THEIR TYPE MUST CONTAIN

TYPES: BEGIN OF TY_LINE_20,
         ID    TYPE C LENGTH 10,
         NAME  TYPE STRING,
