* TASK 25 WRITE AN EXECUTABLE PROGRAM WHICH HAS A ROUTINE THAT RECEIVES AN INTERNAL TABLE OF STRINGS.

*&---------------------------------------------------------------------*
*& ROUTINE TO CONCATENATE STRINGS IN A SIMPLE LINEAR MANNER
*&---------------------------------------------------------------------*
FORM CONCATENATE_STRINGS
  USING
    US_T_STRINGS TYPE TABLE_OF_STRINGS
  CHANGING
    CH_CONCATENATED_STRING TYPE STRING.

  LOOP AT US_T_STRINGS ASSIGNING FIELD-SYMBOL(<STRING_LINE>).
    CONCATENATE CH_CONCATENATED_STRING <STRING_LINE>
      INTO CH_CONCATENATED_STRING.
  ENDLOOP.
ENDFORM.

*&---------------------------------------------------------------------*
*& ROUTINE TO CONCATENATE STRINGS IN MULTIPLE WAYS
*&---------------------------------------------------------------------*
FORM CONCATENATE_STRINGS_IN_WAYS
  USING
    US_T_STRINGS      TYPE TABLE_OF_STRINGS
    US_V_CONCAT_LOGIC TYPE C
  CHANGING
    CH_CONCATENATED_STRING TYPE STRING.

  DATA T_COPYED_STRINGS LIKE US_T_STRINGS.
  T_COPYED_STRINGS = US_T_STRINGS.

  CASE US_V_CONCAT_LOGIC.
    WHEN '1'.
      PERFORM CONCATENATE_STRINGS
        USING T_COPYED_STRINGS
        CHANGING CH_CONCATENATED_STRING.
    WHEN '2'.
      SORT T_COPYED_STRINGS.
      PERFORM CONCATENATE_STRINGS
        USING T_COPYED_STRINGS
        CHANGING CH_CONCATENATED_STRING.
    WHEN '3'.
      SORT T_COPYED_STRINGS DESCENDING.
      PERFORM CONCATENATE_STRINGS
        USING T_COPYED_STRINGS
        CHANGING CH_CONCATENATED_STRING.
    WHEN '4'.
      DATA VL_NUMBER_OF_STRINGS TYPE I.
      FIELD-SYMBOLS <STRING_LINE> TYPE STRING.
      DESCRIBE TABLE T_COPYED_STRINGS LINES VL_NUMBER_OF_STRINGS.

      WHILE VL_NUMBER_OF_STRINGS > 0.
        READ TABLE T_COPYED_STRINGS
          ASSIGNING <STRING_LINE>
          INDEX VL_NUMBER_OF_STRINGS.

        IF SY-SUBRC IS INITIAL.
          CONCATENATE CH_CONCATENATED_STRING <STRING_LINE>
            INTO CH_CONCATENATED_STRING.
        ENDIF.

        UNASSIGN <STRING_LINE>.
        VL_NUMBER_OF_STRINGS = VL_NUMBER_OF_STRINGS - 1.
      ENDWHILE.
  ENDCASE.
ENDFORM.

*&---------------------------------------------------------------------*
*& MAIN PROGRAM EXECUTION
*&---------------------------------------------------------------------*
FORM TASK25.
  DATA IT_STRINGS TYPE TABLE OF STRING.
  DATA GV_CONCATENATED TYPE STRING.

  APPEND 'A' TO IT_STRINGS.
  APPEND 'B' TO IT_STRINGS.
  APPEND 'C' TO IT_STRINGS.
  APPEND 'D' TO IT_STRINGS.
  APPEND 'X' TO IT_STRINGS.
  APPEND 'Y' TO IT_STRINGS.
  APPEND 'Z' TO IT_STRINGS.
  APPEND 'M' TO IT_STRINGS.
  APPEND 'N' TO IT_STRINGS.
  APPEND 'O' TO IT_STRINGS.

  PERFORM CONCATENATE_STRINGS_IN_WAYS
    USING
      IT_STRINGS
      '1'
    CHANGING
      GV_CONCATENATED.
  WRITE: '1 - ', GV_CONCATENATED, /.
  CLEAR GV_CONCATENATED.

  PERFORM CONCATENATE_STRINGS_IN_WAYS
    USING
      IT_STRINGS
      '2'
    CHANGING
      GV_CONCATENATED.
  WRITE: '2 - ', GV_CONCATENATED, /.
  CLEAR GV_CONCATENATED.

  PERFORM CONCATENATE_STRINGS_IN_WAYS
    USING
      IT_STRINGS
      '3'
    CHANGING
      GV_CONCATENATED.
  WRITE: '3 - ', GV_CONCATENATED, /.
  CLEAR GV_CONCATENATED.

  PERFORM CONCATENATE_STRINGS_IN_WAYS
    USING
      IT_STRINGS
      '4'
    CHANGING
      GV_CONCATENATED.
  WRITE: '4 - ', GV_CONCATENATED, /.
  CLEAR GV_CONCATENATED.
ENDFORM.

* TASK 26 WRITE AN EXECUTABLE PROGRAM WITH TWO PARAMETERS TYPES AS INTEGERS.

*&---------------------------------------------------------------------*
*& SELECTION SCREEN PARAMETERS
*&---------------------------------------------------------------------*
SELECTION-SCREEN BEGIN OF BLOCK BT26 WITH FRAME TITLE TEXT-B26.
PARAMETERS:
  P_NUM_26 TYPE INT8,
  P_LEN_26 TYPE I.
SELECTION-SCREEN END OF BLOCK BT26.

*&---------------------------------------------------------------------*
*& ROUTINE TO FORMAT NUMBER WITH FIXED LENGTH
*&---------------------------------------------------------------------*
FORM FORMAT_NUMBER
  USING
    IV_NUMBER TYPE INT8
    IV_LENGTH TYPE I
  CHANGING
    CV_FORMATTED_NUMBER TYPE CHAR255.

  DATA:
    LV_NUMBER_STRING  TYPE STRING,
    LV_NUMBER_LENGTH  TYPE I,
    LV_PADDING_LENGTH TYPE I,
    LV_PADDED_NUMBER  TYPE STRING.

  " CONVERT NUMBER TO STRING
  LV_NUMBER_STRING = |{ IV_NUMBER }|.
  LV_NUMBER_LENGTH = STRLEN( LV_NUMBER_STRING ).

  " DETERMINE PADDING REQUIREMENTS
  IF LV_NUMBER_LENGTH > IV_LENGTH.
    " IF NUMBER IS LONGER THAN DESIRED LENGTH, TRUNCATE FROM LEFT
    DATA(LV_INDEX) = LV_NUMBER_LENGTH - IV_LENGTH.
    LV_PADDED_NUMBER = LV_NUMBER_STRING+LV_INDEX(IV_LENGTH).
  ELSE.
    " IF NUMBER IS SHORTER, PAD WITH ZEROS
    LV_PADDING_LENGTH = IV_LENGTH - LV_NUMBER_LENGTH.

    " CREATE PADDING STRING
    LV_PADDED_NUMBER =
      REPEAT( VAL = '0'
              OCC = LV_PADDING_LENGTH ) && LV_NUMBER_STRING.
  ENDIF.
  " RETURN FORMATTED NUMBER
  CV_FORMATTED_NUMBER = LV_PADDED_NUMBER.
ENDFORM.

FORM TASK26.
  IF P_NUM_26 IS INITIAL OR P_LEN_26 IS INITIAL.
    RETURN.
  ENDIF.
  PERFORM FORMAT_NUMBER
    USING P_NUM_26 P_LEN_26
    CHANGING SY-LISEL.

  WRITE: / SY-LISEL.
ENDFORM.

